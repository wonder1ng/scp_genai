from dotenv import load_dotenv
from langchain_openai import OpenAI     # 일반 LLM (구형)
from langchain_openai import ChatOpenAI # 챗 LLM
from langchain_core.messages import SystemMessage, HumanMessage

load_dotenv()


MODEL1 = "gpt-3.5-turbo-instruct"
MODEL2 = "gpt-4o-mini"

llm1 = OpenAI(model=MODEL1)
prompt1 = "다음 문장을 한국어로 번역해: Good Morning"
print(llm1.invoke(prompt1))
print("=" * 30)

llm2 = ChatOpenAI(model=MODEL2)
prompt2 = "게임 회사를 창업하려는데 이름 후보 3개 작명"
print(llm2.invoke(prompt2))
print("=" * 30)

prompt3 = [
    SystemMessage(content="당신은 창의력 높은 작명가입니다."),
    HumanMessage(content=prompt2),
]

print(llm2.invoke(prompt3))
print("=" * 30)

